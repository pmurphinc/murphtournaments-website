# Server-only API key used by server/routers.ts for Google Sheets API requests.
# Keep this value out of client-side VITE_* variables and never commit a real key.
GOOGLE_SHEETS_API_KEY=your-google-sheets-api-key

# Optional Twitch metadata integration.
TWITCH_CLIENT_ID=your-twitch-client-id
TWITCH_CLIENT_SECRET=your-twitch-client-secret

# Auth/session and database configuration.
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgres://user:password@host:5432/database
OAUTH_SERVER_URL=https://example.com
OWNER_OPEN_ID=owner-open-id
VITE_APP_ID=your-app-id

# Discord OAuth for all Discord website users, including Team Finder, Team Management, and personal /TCR. Use identify scope only.
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_REDIRECT_URI=https://your-domain.example/api/auth/discord/callback

# Optional Discord bot for lobby-code DM attempts. Personal /TCR also stores
# released lobby codes on the website for captain-only fallback access. Never
# expose DISCORD_BOT_TOKEN as a VITE_* browser variable.
DISCORD_BOT_TOKEN=your-discord-bot-token

# MTC Discord TCR staff access only. Personal /TCR must not depend on these
# guild or role variables. The bot must already be in the Murph Tournaments
# Discord server for role checks. Copy IDs from Discord Developer Mode.
DISCORD_GUILD_ID=your-murph-tournaments-guild-id
# Comma-separated role IDs allowed to access Tournament Control. Include the
# Murph/owner role, admin role, and staff role IDs as needed. Legacy single-role
# variables below are still supported for backward compatibility.
DISCORD_TOURNAMENT_CONTROL_ROLE_IDS=your-owner-role-id,your-tournament-admin-role-id,your-tournament-staff-role-id
DISCORD_TOURNAMENT_ADMIN_ROLE_ID=your-tournament-admin-role-id
DISCORD_TOURNAMENT_STAFF_ROLE_ID=your-tournament-staff-role-id

# Manus/Forge platform services when running in that environment.
BUILT_IN_FORGE_API_URL=https://example.com
BUILT_IN_FORGE_API_KEY=your-forge-api-key

# Discord tournament webhook authentication.
TOURNAMENT_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret

# Personal Tournament Control Room (/TCR) is public: any Discord-authenticated
# user can create and run tournaments, bounded by PERSONAL_TCR_LIMITS in
# server/tournamentControl.ts. The former TCR_ALPHA_MODE and
# TCR_ALPHA_ALLOWED_DISCORD_IDS invite gate has been removed; if either is
# still set in a deployment environment it is now ignored and can be deleted.

# Umami analytics. Both are read by Vite at BUILD time and baked into the
# bundle, so they must be set in the build environment, not just at runtime:
# in Railway that means service variables of these names, which the
# Dockerfile declares as ARGs so the build receives them. Leave either blank
# and the page simply ships without an analytics tag.
#
# ENDPOINT is the origin your Umami instance is served from, with no trailing
# slash and no /umami suffix; the loader path is appended for you.
VITE_ANALYTICS_ENDPOINT=https://analytics.example.com
VITE_ANALYTICS_WEBSITE_ID=00000000-0000-0000-0000-000000000000
